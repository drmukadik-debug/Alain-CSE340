
<%- include('partials/header') %>

<main class="container page-content">

    <section class="page-intro">
        <p class="eyebrow">Working together</p>
        <h1><%= title %></h1>

        <p>
            Meet the organizations working with us to
            create positive changes in our communities.
        </p>
    </section>

    <section class="organization-grid">

        <% organizations.forEach(organization => { %>

            <article class="organization-card">

                <img
                    src="/images/<%= organization.logo_filename %>"
                    alt="<%= organization.name %> logo"
                >

                <h2><%= organization.name %></h2>

                <p>
                    <%= organization.description %>
                </p>

                <a href="mailto:<%= organization.contact_email %>">
                    Contact Organization
                </a>

            </article>

        <% }); %>

    </section>

</main>

<%- include('partials/footer') %>
