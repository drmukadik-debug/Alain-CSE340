
<%- include('partials/header') %>

<main class="container page-content">

    <section class="page-intro">
        <p class="eyebrow">Working together</p>
        <h1><%= title %></h1>

        <p>
            Meet the organizations working with us to
            create positive changes in our communities.
        </p>
    </section>

    <section class="organization-grid">

        <article class="organization-card">
            <img
                src="/images/brightfuture-logo.png"
                alt="Bright Future organization logo"
            >
            <h2>Bright Future</h2>
            <p>
                Supporting education and creating learning
                opportunities for children and young people.
            </p>
            <a href="mailto:info@brightfuture.org">
                Contact Organization
            </a>
        </article>

        <article class="organization-card">
            <img
                src="/images/greenharvest-logo.png"
                alt="Green Harvest organization logo"
            >
            <h2>Green Harvest</h2>
            <p>
                Promoting environmental protection,
                sustainability, and community gardening.
            </p>
            <a href="mailto:info@greenharvest.org">
                Contact Organization
            </a>
        </article>

        <article class="organization-card">
            <img
                src="/images/unityserve-logo.png"
                alt="Unity Serve organization logo"
            >
            <h2>Unity Serve</h2>
            <p>
                Connecting volunteers with community
                development and social support projects.
            </p>
            <a href="mailto:info@unityserve.org">
                Contact Organization
            </a>
        </article>

    </section>

</main>

<%- include('partials/footer') %>
