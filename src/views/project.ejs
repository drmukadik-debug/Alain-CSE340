
<%- include('partials/header') %>

<main class="container page-content">

    <h1><%= title %></h1>

    <% if (project) { %>

        <p>
            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
            |
            <a href="/assign-categories/<%= project.project_id %>">
                Edit Categories
            </a>
        </p>

        <section class="project-details">

            <h2><%= project.title %></h2>

            <p>
                <strong>Description:</strong>
                <%= project.description %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= project.date %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <p>
                <strong>Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <section class="project-categories">
                <h3>Categories</h3>

                <% if (categories && categories.length > 0) { %>
                    <ul>
                        <% categories.forEach(category => { %>
                            <li>
                                <a href="/category/<%= category.category_id %>">
                                    <%= category.category_name %>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p>No categories assigned to this project.</p>
                <% } %>

            </section>

        </section>

    <% } else { %>
        <p>Project not found.</p>
    <% } %>

</main>

<%- include('partials/footer') %>
