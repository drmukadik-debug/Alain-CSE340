<%- include('partials/header') %>

    <main class="container">

        <section class="hero">
            <div class="hero-content">

                <p class="eyebrow">Welcome to our community</p>

                <h1>
                    <%= title %>
                </h1>

                <h2>Making a Difference Through Service</h2>

                <p>
                    Our mission is to connect volunteers with
                    meaningful service opportunities that improve
                    communities and transform lives.
                </p>

                <a href="/projects" class="btn">
                    Explore Service Projects
                </a>

            </div>

            <div class="hero-image">
                <img src="/images/logo.svg" alt="CSE 340 Service Network" class="main-logo">
            </div>
        </section>

        <section class="welcome-section">

            <h2>Our Purpose</h2>

            <p>
                We believe that everyone can make a positive
                contribution to society. Through collaboration,
                compassion, and community engagement, we create
                opportunities to serve others.
            </p>

        </section>

    </main>

    <%- include('partials/footer') %>