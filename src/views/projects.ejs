
<%- include('partials/header') %>

<main class="container page-content">

    <section class="page-intro">
        <p class="eyebrow">Make a difference</p>
        <h1><%= title %></h1>

        <p>
            Discover meaningful projects where volunteers
            can contribute their time and talents.
        </p>
    </section>

    <section class="project-grid">

        <article class="project-card">
            <h2>Park Cleanup</h2>
            <p class="project-category">Environmental</p>
            <p>
                Join volunteers to clean public parks,
                collect waste, and improve green spaces.
            </p>
        </article>

        <article class="project-card">
            <h2>Community Food Drive</h2>
            <p class="project-category">Community Service</p>
            <p>
                Help collect and distribute food to
                families and individuals in need.
            </p>
        </article>

        <article class="project-card">
            <h2>Community Tutoring</h2>
            <p class="project-category">Educational</p>
            <p>
                Help students improve their learning
                through tutoring and educational support.
            </p>
        </article>

    </section>

    <section class="project-cta">
        <h2>Ready to make a difference?</h2>
        <p>Explore our service project categories.</p>
        <a href="/categories" class="btn">
            Explore Categories
        </a>
    </section>

</main>

<%- include('partials/footer') %>
