
<%- include('partials/header') %>

<main class="container page-content">
    <section class="form-container">
        <h1><%= projectDetails.title %></h1>
        <h2><%= title %></h2>

        <form action="/assign-categories/<%= projectId %>" method="POST">
            <div class="form-group">
                <% categories.forEach(category => { %>
                    <div>
                        <input
                            type="checkbox"
                            id="category-<%= category.category_id %>"
                            name="categoryIds"
                            value="<%= category.category_id %>"
                            <%= assignedCategories.some(ac => String(ac.category_id) === String(category.category_id)) ? 'checked' : '' %>
                        />
                        <label for="category-<%= category.category_id %>">
                            <%= category.category_name %>
                        </label>
                    </div>
                <% }); %>
            </div>

            <button type="submit">Update Categories</button>
        </form>

        <p>
            <a href="/project/<%= projectId %>">Cancel and return to project</a>
        </p>
    </section>
</main>

<%- include('partials/footer') %>
