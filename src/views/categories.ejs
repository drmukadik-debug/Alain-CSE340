<%- include('partials/header') %>

<main class="container page-content">

    <section class="page-intro">
        <p class="eyebrow">Discover ways to serve</p>
        <h1><%= title %></h1>

        <p>
            Explore our different service categories
            and find an opportunity to contribute.
        </p>
    </section>

    <section class="category-grid">

        <% categories.forEach(category => { %>

            <article class="category-card">

                <div class="category-icon" aria-hidden="true">🌱</div>

                <h2><%= category.category_name %></h2>

                <p>
                    Explore service projects and opportunities
                    related to <%= category.category_name %>.
                </p>

            </article>

        <% }); %>

    </section>

</main>

<%- include('partials/footer') %>
