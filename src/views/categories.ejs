
<%- include('partials/header') %>

<main class="container page-content">

    <section class="page-intro">
        <p class="eyebrow">Discover ways to serve</p>
        <h1><%= title %></h1>

        <p>
            Explore our different service categories
            and find an opportunity to contribute.
        </p>
    </section>

    <section class="category-grid">

        <article class="category-card">
            <div class="category-icon" aria-hidden="true">🌱</div>
            <h2>Environmental</h2>
            <p>
                Protect the environment through tree planting,
                park cleanups, and conservation activities.
            </p>
        </article>

        <article class="category-card">
            <div class="category-icon" aria-hidden="true">📚</div>
            <h2>Educational</h2>
            <p>
                Support education through tutoring,
                literacy programs, and learning activities.
            </p>
        </article>

        <article class="category-card">
            <div class="category-icon" aria-hidden="true">🤝</div>
            <h2>Community Service</h2>
            <p>
                Strengthen communities through volunteering,
                outreach, and social support.
            </p>
        </article>

        <article class="category-card">
            <div class="category-icon" aria-hidden="true">💚</div>
            <h2>Health and Wellness</h2>
            <p>
                Promote healthy communities through health
                education and wellness activities.
            </p>
        </article>

    </section>

</main>

<%- include('partials/footer') %>
