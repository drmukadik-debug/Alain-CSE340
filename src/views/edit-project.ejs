
<%- include('partials/header') %>

<main class="container page-content">

    <h1>Edit Service Project</h1>

    <form
        class="edit-project-form"
        action="/edit-project/<%= project.project_id %>"
        method="POST"
    >

        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                required
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="date">Project Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= String(project.date).slice(0, 10) %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select
                id="organizationId"
                name="organizationId"
                required
            >
                <% organizations.forEach(organization => { %>
                    <option
                        value="<%= organization.organization_id %>"
                        <%= String(organization.organization_id) === String(project.organization_id) ? 'selected' : '' %>
                    >
                        <%= organization.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-actions">
            <button class="submit-btn" type="submit">
                Update Project
            </button>

            <a
                class="cancel-btn"
                href="/project/<%= project.project_id %>"
            >
                Cancel
            </a>
        </div>

    </form>

</main>

<%- include('partials/footer') %>
